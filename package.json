{
  "name": "@sharework-ai/dsh-docwright",
  "description": "Document generation for deepseek-harness: quality packs (schema + rules), a validation repair loop, chained scenarios, params with a confirmation gate, replayable receipts, and a pack authoring skill",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./pack": {
      "types": "./lib/pack.d.ts",
      "default": "./lib/pack.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharework-ai/docwright.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "packs",
    "guides",
    "cordis.patch.yml"
  ],
  "keywords": [
    "docwright",
    "dsh-plugin",
    "deepseek-harness",
    "document-generation",
    "validation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-scope": "link:../deepseek-harness/packages/core/scope",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-timeout": "link:../deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-util-values": "link:../deepseek-harness/packages/util/values",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^3.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown && pnpm run build:client",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "spike:convergence": "node --import tsx/esm spike/convergence.ts",
    "smoke:host": "node --import tsx/esm scripts/host-smoke.ts",
    "pack:check": "node --import tsx/esm scripts/pack-check.ts",
    "build:client": "tsdown -c tsdown.client.ts && node scripts/normalize-client-banner.mjs"
  }
}
