        { "description": "用户在收藏列表提交取消收藏请求，指明目标商品", "dataMovementType": "E", "dataGroup": "取消请求", "dataProperties": ["用户ID", "商品ID"], "cfp": 1 },
        { "description": "系统读取对应收藏记录确认其存在与当前状态", "dataMovementType": "R", "dataGroup": "收藏记录", "dataProperties": ["收藏ID", "记录状态"], "cfp": 1 },
        { "description": "系统更新收藏记录状态并登记取消时间", "dataMovementType": "W", "dataGroup": "收藏记录", "dataProperties": ["记录状态", "取消时间"], "cfp": 1 },
        { "description": "系统向用户反馈取消结果", "dataMovementType": "X", "dataGroup": "取消结果", "dataProperties": ["取消状态", "提示信息"], "cfp": 1 }
      ]
    },
    {
      "index": 3,
      "name": "查询收藏列表",
