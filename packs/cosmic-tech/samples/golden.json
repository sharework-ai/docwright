        { "description": "系统读取既有收藏记录中的已收藏标记", "dataMovementType": "R", "dataGroup": "收藏记录", "dataProperties": ["已收藏标记", "收藏时间"], "cfp": 1 },
        { "description": "系统读取商品档案核对商品当前状态", "dataMovementType": "R", "dataGroup": "商品档案", "dataProperties": ["商品ID", "商品状态"], "cfp": 1 },
