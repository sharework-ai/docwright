  "diagrams": [
    "sequenceDiagram\n    autonumber\n    actor u as 注册用户\n    participant fav as 收藏服务\n    participant db as 收藏库\n    participant prod as 商品服务\n    u->>fav: E 收藏请求\n    fav->>db: W 收藏记录\n    fav->>prod: R 商品档案\n    fav-->>u: X 收藏结果"
  ],
  "processes": [
    {
      "index": 1,
      "name": "收藏商品",
      "description": "将用户提交的收藏请求落为收藏记录，核对商品有效性后反馈结果。",
      "originator": "注册用户",
      "receiver": "收藏服务",
      "origination_event": "用户在商品详情页点击“收藏”按钮",
      "subProcesses": [
