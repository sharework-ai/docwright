        { "description": "系统将本次收藏写入收藏记录，登记收藏时间", "dataMovementType": "W", "dataGroup": "收藏记录", "dataProperties": ["用户ID", "商品ID", "收藏时间"], "cfp": 1 },
        { "description": "系统读取商品档案核对商品在售状态", "dataMovementType": "R", "dataGroup": "商品档案", "dataProperties": ["商品ID", "商品状态"], "cfp": 1 },
        { "description": "系统向用户反馈收藏结果与最新收藏状态", "dataMovementType": "X", "dataGroup": "收藏结果", "dataProperties": ["收藏状态", "提示信息"], "cfp": 1 }
      ]
    },
    {
      "index": 2,
      "name": "取消收藏",
      "description": "根据用户的取消请求更新对应收藏记录并反馈结果。",
      "originator": "注册用户",
      "receiver": "收藏服务",
      "origination_event": "用户在收藏列表中点击“取消收藏”",
