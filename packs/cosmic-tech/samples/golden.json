        { "description": "系统读取用户的收藏记录清单", "dataMovementType": "R", "dataGroup": "收藏记录", "dataProperties": ["收藏ID", "商品ID"], "cfp": 1 },
        { "description": "系统读取商品档案补充名称与价格信息", "dataMovementType": "R", "dataGroup": "商品档案", "dataProperties": ["商品名称", "价格"], "cfp": 1 },
        { "description": "系统向用户返回生成的导出文件", "dataMovementType": "X", "dataGroup": "导出文件", "dataProperties": ["文件内容", "导出时间"], "cfp": 1 }
