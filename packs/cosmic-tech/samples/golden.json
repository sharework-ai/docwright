        { "description": "系统生成提醒任务并登记计划发送时间", "dataMovementType": "W", "dataGroup": "提醒任务", "dataProperties": ["任务ID", "发送时间"], "cfp": 1 },
        { "description": "系统向收藏用户发出降价通知", "dataMovementType": "X", "dataGroup": "降价通知", "dataProperties": ["用户ID", "降价信息"], "cfp": 1 }
