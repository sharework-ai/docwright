{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "COSMIC Project Context",
  "description": "Project-level knowledge anchoring the whole COSMIC chain: module tree, roles, third-party systems, ID conventions, and design principles (docs/designs/cosmic-context.md)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "docType",
    "projectName",
    "language",
    "background",
    "overview",
    "modules",
    "roles",
    "thirdPartySystems",
    "moduleIdConventionForLevel1",
    "designPrinciples",
    "assumptions"
  ],
  "properties": {
    "docType": { "const": "context" },
    "projectName": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "background": {
      "type": "string",
      "minLength": 20,
      "description": "Business background: the business domain and problem the project serves"
    },
    "overview": {
      "type": "string",
      "minLength": 20,
      "description": "System overview: what the system does at a high level"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "description": "Module tree, first level; the actual maximum depth must equal the effective param moduleLevels (rule context/module-depth)",
      "items": { "$ref": "#/definitions/moduleLevel1" }
    },
    "roles": {
      "type": "array",
      "description": "In-project roles in exactly three kinds: person, organization, system",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "kind", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["person", "organization", "system"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "thirdPartySystems": {
      "type": "array",
      "description": "External systems the project depends on or interacts with",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "purpose", "interaction"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1, "description": "What the third-party system is" },
          "interaction": { "type": "string", "minLength": 1, "description": "How this system interacts with it" }
        }
      }
    },
    "moduleIdConventionForLevel1": { "enum": ["numeric", "alphabetic"] },
    "moduleIdConventionForLevel2": { "enum": ["numeric", "alphabetic"] },
    "moduleIdConventionForLevel3": { "enum": ["numeric", "alphabetic"] },
    "designPrinciples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "description": "Items the model assumed because the materials did not cover them; reviewed and promoted or corrected by a human (rule context/assumptions-review)",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "moduleLevel1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "code", "responsibility"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,8}$",
          "description": "Module ID (abbreviation code or ordinal); unique across the whole tree (rule context/module-code-unique); funcId segments in the plan stage are module code chains"
        },
        "path": { "type": "string", "description": "Optional code location of the module; never validated by the rule engine" },
        "responsibility": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/definitions/moduleLevel2" } }
      }
    },
    "moduleLevel2": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "code", "responsibility"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9]{1,8}$" },
        "path": { "type": "string" },
        "responsibility": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/definitions/moduleLevel3" } }
      }
    },
    "moduleLevel3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "responsibility"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9]{1,8}$" },
        "path": { "type": "string" },
        "responsibility": { "type": "string", "minLength": 1 }
      }
    }
  }
}
